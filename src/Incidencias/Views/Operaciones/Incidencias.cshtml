@model List<Incidencias.Models.Incidencia>
@using Incidencias.Services
@inject IConfiguration Config
@{
    ViewData["Title"] = "Incidencias";
    var esSupervisor = User.IsInRole(Incidencias.Data.SeedData.RolSupervisor);
}

<h1>Incidencias abiertas en tiempo real</h1>

<p><span id="estado-ws" class="badge bg-secondary">WebSocket: conectando…</span></p>
<div id="aviso-ws" class="alert alert-info" hidden></div>

<form method="get" asp-action="Incidencias" class="row g-2 mb-3" role="search">
    <div class="col-sm-8">
        <input type="search" name="q" value="@ViewData["Busqueda"]" class="form-control"
               placeholder="Buscar por estación o descripción" />
    </div>
    <div class="col-sm-4">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Incidencias" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (ViewData["ErrorBusqueda"] is string errorBusqueda)
{
    <div class="alert alert-warning">@errorBusqueda</div>
}

<p class="text-muted">Total: <span id="total-incidencias">@Model.Count</span></p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Estación</th>
            <th>Descripción</th>
            <th>Prioridad</th>
            <th>Estado</th>
            @if (esSupervisor)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody id="lista-incidencias">
        @foreach (var item in Model)
        {
            <tr id="incidencia-@item.Id" data-id="@item.Id">
                <td>@item.Id</td>
                <td>@item.Estacion</td>
                <td>@item.Descripcion</td>
                <td>@item.Prioridad</td>
                <td class="estado">@item.Estado</td>
                @if (esSupervisor)
                {
                    <td>
                        <form asp-action="Cerrar" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-danger">Cerrar</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<p id="sin-incidencias" hidden="@(Model.Count > 0)">No hay incidencias abiertas.</p>

@section Scripts {
    <script>
        (function () {
            // Solo la API key pública de PieHost llega al navegador; el secreto queda en el servidor.
            const cfg = {
                cluster: @Json.Serialize(PieHostPublisher.Host(Config["PieHost:ClusterId"] ?? "")),
                apiKey: @Json.Serialize(Config["PieHost:ApiKey"] ?? ""),
                canal: @Json.Serialize(PieHostPublisher.Canal(Config)),
                urlEstado: @Json.Serialize(Url.Action("EstadoIncidencias", "Operaciones"))
            };
            const badge = document.getElementById("estado-ws");
            const aviso = document.getElementById("aviso-ws");
            let intentos = 0;
            let conectadoAntes = false;

            function mostrarEstado(texto, clase) {
                badge.textContent = "WebSocket: " + texto;
                badge.className = "badge " + clase;
            }

            function actualizarTotal() {
                const total = document.querySelectorAll("#lista-incidencias tr[data-id]").length;
                document.getElementById("total-incidencias").textContent = total;
                document.getElementById("sin-incidencias").hidden = total > 0;
            }

            function quitarFila(id) {
                const fila = document.getElementById("incidencia-" + id);
                if (fila) {
                    fila.remove();
                    actualizarTotal();
                }
            }

            function aplicarEvento(data) {
                const id = data.Id ?? data.id;
                const estado = data.Estado ?? data.estado;
                if (estado === "Cerrada") {
                    quitarFila(id);
                    aviso.textContent = "Incidencia #" + id + " cerrada (actualizado en tiempo real).";
                    aviso.hidden = false;
                } else {
                    sincronizar();
                }
            }

            // Consulta el estado vigente en el servidor y retira de la lista lo que ya no está abierto.
            async function sincronizar() {
                try {
                    const r = await fetch(cfg.urlEstado, { headers: { "Accept": "application/json" } });
                    if (!r.ok) return;
                    const abiertas = new Set((await r.json()).map(i => Number(i.id ?? i.Id)));
                    document.querySelectorAll("#lista-incidencias tr[data-id]").forEach(tr => {
                        if (!abiertas.has(Number(tr.dataset.id))) tr.remove();
                    });
                    actualizarTotal();
                } catch (e) {
                    console.warn("No se pudo consultar el estado vigente", e);
                }
            }

            function conectar() {
                const url = "wss://" + cfg.cluster + "/v3/" + encodeURIComponent(cfg.canal) +
                    "?api_key=" + encodeURIComponent(cfg.apiKey) + "&notify_self=1";
                const ws = new WebSocket(url);

                ws.onopen = function () {
                    mostrarEstado("conectado", "bg-success");
                    if (conectadoAntes) {
                        console.info("WebSocket reconectado: consultando estado vigente");
                        sincronizar();
                    }
                    conectadoAntes = true;
                    intentos = 0;
                };

                ws.onmessage = function (e) {
                    let msg;
                    try {
                        msg = JSON.parse(e.data);
                        if (typeof msg === "string") msg = JSON.parse(msg);
                    } catch {
                        return;
                    }
                    if (msg && msg.event === "IncidenciaActualizada" && msg.data) {
                        aplicarEvento(msg.data);
                    }
                };

                ws.onclose = function () {
                    mostrarEstado("desconectado, reintentando…", "bg-warning text-dark");
                    const espera = Math.min(30000, 1000 * Math.pow(2, intentos++));
                    setTimeout(conectar, espera);
                };
            }

            if (!cfg.apiKey || !cfg.cluster) {
                mostrarEstado("no configurado", "bg-secondary");
                return;
            }
            conectar();
        })();
    </script>
}
