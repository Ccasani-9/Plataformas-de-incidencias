@model List<Incidencias.Models.Incidencia>
@{
    ViewData["Title"] = "Incidencias";
    var esSupervisor = User.IsInRole(Incidencias.Data.SeedData.RolSupervisor);
}

<h1>Incidencias abiertas con consulta rápida</h1>

<p class="text-muted">Total: <span id="total-incidencias">@Model.Count</span></p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Estación</th>
            <th>Descripción</th>
            <th>Prioridad</th>
            <th>Estado</th>
            @if (esSupervisor)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody id="lista-incidencias">
        @foreach (var item in Model)
        {
            <tr id="incidencia-@item.Id" data-id="@item.Id">
                <td>@item.Id</td>
                <td>@item.Estacion</td>
                <td>@item.Descripcion</td>
                <td>@item.Prioridad</td>
                <td class="estado">@item.Estado</td>
                @if (esSupervisor)
                {
                    <td>
                        <form asp-action="Cerrar" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-danger">Cerrar</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p id="sin-incidencias">No hay incidencias abiertas.</p>
}
